+             {"kind": "die", "reference_id": "R1", "layout_id": "l1n0", "die_id": "d0", "Tj_l0_K": 340.0,
+              "Tj_l1_K": 340.0, "Tj_l2_K": 340.0},
+             {"kind": "runner_note", "text": "no reference"}]
+    base_min, base_max = mx.headroom_min_lo(rows), mx.headroom_max_hi_ind(rows)
